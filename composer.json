{
    "name": "remessage/ruleset",
    "description": "PHP CS Fixer rule set",
    "type": "project",
    "license": "Apache-2.0",
    "homepage": "https://dev.remessage.ru/packages/ruleset",
    "authors": [
        {
            "name": "Oleg Kozlov",
            "email": "h1karo@remessage.ru",
            "role": "Developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "RM\\Style\\RuleSet\\": "src/"
        }
    },
    "require": {
        "php": ">=8.4",

        "friendsofphp/php-cs-fixer": "^3.75"
    },
    "require-dev": {
        "vimeo/psalm": "^6.12"
    },
    "scripts": {
        "psalm": "psalm",
        "test": "phpunit --testdox",
        "lint": "PHP_CS_FIXER_IGNORE_ENV=true php-cs-fixer fix --show-progress=dots"
    },
    "config": {
        "sort-packages": false
    }
}
